# Render @brief / @param / @p etc. as Markdown in hover (clangd 22+).
Documentation:
  CommentFormat: Doxygen

# ARM Pico firmware is cross-compiled; clangd needs newlib headers for stdio/assert.
# Scoped to firmware trees so host C++ (software/jtsmm/native) is unaffected.
---
If:
  PathMatch: (firmware|bringup)/.*
CompileFlags:
  Add:
    - -isystem
    - /usr/include/newlib
