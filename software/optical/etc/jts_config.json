{
  "data_source": {
    "type": "qualisys",
    "filename": "path/to/recording.mat"
  },

  "analysis": {
    "description": "Jaw motion analysis (template)",

    "calibration": {
      "mandibular": {
        "rigid_bodies": ["MP", "CT"],
        "points": [
          {
            "name": "mand_point_1",
            "frame_interval": [2300, 3300]
          },
          {
            "name": "mand_point_2",
            "frame_interval": [6250, 7250]
          },
          {
            "name": "mand_point_3",
            "frame_interval": [8800, 9800]
          }
        ]
      },

      "maxillary": {
        "rigid_bodies": ["HP", "CT"],
        "points": [
          {
            "name": "max_point_1",
            "frame_interval": [11700, 12700]
          },
          {
            "name": "max_point_2",
            "frame_interval": [18200, 19200]
          },
          {
            "name": "max_point_3",
            "frame_interval": [22000, 23000]
          }
        ]
      }
    },

    "experiment": {
      "frame_interval": [24000, 42800],
      "use_sub_experiments": false,
      "combine_sub_experiments": ["sensors_2025"],

      "sub_experiments": {
        "open_close": [25000, 28200],
        "left_right": [28200, 31300],
        "protrusion_retrusion": [31300, 34200],
        "chewing": [34200, 38800],
        "open_close_wide": [39400, 40500],
        "complex_motion": [
          [25000, 26600],
          [28200, 29750],
          [31300, 32750]
        ],
        "sensors_2025": [
          [25000, 26600],
          [28200, 29750],
          [31300, 32750],
          [34200, 36500],
          [39400, 40500]
        ]
      },

      "interpolation": {
        "method": "cubic",
        "transition_frames": 10,
        "connect_intervals": true
      }
    },

    "relative_motion": {
      "reference_body": "HP",
      "moving_body": "MP"
    },

    "coordinate_transform": {
      "enabled": true,
      "calibration_type": "maxillary",
      "model_points": [
        [-0.244678, -109.416, 101.356],
        [23.6189, -106.201, 73.9031],
        [-24.0445, -106.078, 74.1795]
      ]
    },

    "smoothing": {
      "enabled": true,
      "window_length": 11,
      "poly_order": 3
    },

    "coordinate_origin_index": 0
  },

  "visualization": {
    "raw_data": false,
    "raw_data_3d": false,
    "calibration_transforms": false,
    "relative_marker_motion": false,
    "landmark_motion": false,
    "final_trajectory": true,
    "plot_2d_components": true,
    "plot_export_only": true,
    "plot_rot_3d": false,
    "show_plots": true,
    "use_tex_font": true,

    "plot_style": {
      "sample_rate": 10,
      "linewidth": 1.5,
      "axes_label_fontsize": 32,
      "axes_tick_fontsize": 24,
      "title_fontsize": 18,
      "legend_fontsize": 12,
      "figure_size": [12, 8],
      "labelpad_scale": 0.7,

      "view_3d": {
        "elev": 15,
        "azim": -45,
        "roll": 0,
        "vertical_axis": "y"
      },

      "colors": ["tab:blue", "tab:orange", "tab:green", "tab:red", "tab:purple", "tab:brown"],
      "line_styles": ["-", "--", "-.", ":"],

      "grid": {
        "enabled": true,
        "alpha": 0.3
      }
    }
  },

  "output": {
    "directory": "./analysis_results",
    "save_csv": true,
    "save_hdf5": true,
    "save_plots": false,
    "save_tikz": false,
    "csv_filename": "jaw_motion",
    "hdf5_filename": "jaw_motion.h5",
    "store_quaternions": true,
    "derivative_order": 2,
    "scale_factor": 0.001,
    "unit": "m"
  }
}
