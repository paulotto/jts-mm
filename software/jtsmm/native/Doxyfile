WARN_NO_PARAMDOC       = YES
INPUT                  = include src
FILE_PATTERNS          = *.cpp *.hpp
RECURSIVE              = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
HAVE_DOT               = NO
SOURCE_BROWSER         = YES
ALPHABETICAL_INDEX     = YES
QUIET                  = YES
