[Unit]
Description=JTS-MM Wi-Fi disable guard (boot + expiry)
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/pi_wifi --guard
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
