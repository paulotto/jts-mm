[Unit]
Description=JTS-MM Wi-Fi disable expiry check

[Timer]
OnBootSec=30s
OnUnitActiveSec=60s
AccuracySec=10s
Unit=jtsmm-wifi-guard.service

[Install]
WantedBy=timers.target
